#!/usr/bin/env bash
UA="GooseTRM/1.0 (weather-alerts)"
SF_FORECAST_URL="https://api.weather.gov/gridpoints/MTR/84,105/forecast"
SF_HOURLY_URL="https://api.weather.gov/gridpoints/MTR/84,105/forecast/hourly"
OAK_FORECAST_URL="https://api.weather.gov/gridpoints/MTR/90,106/forecast"
OAK_HOURLY_URL="https://api.weather.gov/gridpoints/MTR/90,106/forecast/hourly"
ALERTS_URL="https://api.weather.gov/alerts/active?zone=CAZ006,CAZ508"

# ── Which day is being reported ──────────────────────────────────────
# In the evening the forecast for the day that is ending has nothing left to
# say, so the panel reports tomorrow instead and labels itself accordingly.
# $IS_EVENING comes from ./update, which owns the clock for the whole run;
# $WEATHER_TARGET overrides it outright, which is what the tests use.
if [ -n "${WEATHER_TARGET:-}" ]; then
  TARGET="$WEATHER_TARGET"
elif [ "${IS_EVENING:-false}" = "true" ]; then
  TARGET="tomorrow"
else
  TARGET="today"
fi

if [ "$TARGET" = "tomorrow" ]; then
  TARGET_DATE=$(date -d "tomorrow" +"%Y-%m-%d")
  # A floor as well as a ceiling: without it the rain window would sweep up
  # every remaining hour of tonight and report it as tomorrow's.
  WINDOW_FROM="${TARGET_DATE}T00:00:00"
  # Match periods by date so "the daytime one" means tomorrow's, not the next
  # one that happens to exist.
  MATCH_DATE="$TARGET_DATE"
else
  TARGET_DATE=$(date +"%Y-%m-%d")
  # Today keeps the original unanchored behaviour exactly: no floor on the rain
  # window, and the first daytime period whatever its date. After sunset there
  # is no daytime period left for today, and that first one is already
  # tomorrow's — long-standing, and what makes the row survive the evening at
  # all rather than going blank between sunset and the switch.
  WINDOW_FROM=""
  MATCH_DATE=""
fi
WINDOW_TO="${TARGET_DATE}T23:00:00"

extract_forecast() {
  local period_json="$1"
  local hourly_json="$2"
  local window_to="$3"
  local window_from="$4"
  local match_date="$5"
  jq -n --arg to "$window_to" --arg from "$window_from" --arg day "$match_date" \
    --slurpfile periods <(printf '%s' "$period_json") \
    --slurpfile hourly <(printf '%s' "$hourly_json") '
    # An empty $day means "first period of its kind, whatever its date", which
    # is the original behaviour; a set $day pins both readings to that date.
    def on_day: select($day == "" or (.startTime | startswith($day)));
    $periods[0].properties.periods as $p |
    ($p | map(select(.isDaytime == true)  | on_day) | .[0].temperature) as $high |
    ($p | map(select(.isDaytime == false) | on_day) | .[0].temperature) as $low |
    ($hourly[0].properties.periods
      | map(select(.startTime < $to and ($from == "" or .startTime >= $from)))
      | map(.probabilityOfPrecipitation.value // 0)
      | max // 0
    ) as $rain_chance |
    {
      high: $high,
      low: $low,
      rain: ($rain_chance >= 30),
      rain_chance: $rain_chance
    }
  '
}

SF_RAW=$(curl -sf -H "User-Agent: $UA" "$SF_FORECAST_URL")
SF_OK=$?
SF_HOURLY_RAW=$(curl -sf -H "User-Agent: $UA" "$SF_HOURLY_URL")
SF_HOURLY_OK=$?
OAK_RAW=$(curl -sf -H "User-Agent: $UA" "$OAK_FORECAST_URL")
OAK_OK=$?
OAK_HOURLY_RAW=$(curl -sf -H "User-Agent: $UA" "$OAK_HOURLY_URL")
OAK_HOURLY_OK=$?
ALERTS_RAW=$(curl -sf -H "User-Agent: $UA" "$ALERTS_URL")

if [ $SF_OK -eq 0 ] && [ $SF_HOURLY_OK -eq 0 ]; then
  SF_FORECAST=$(extract_forecast "$SF_RAW" "$SF_HOURLY_RAW" "$WINDOW_TO" "$WINDOW_FROM" "$MATCH_DATE")
else
  SF_FORECAST="null"
fi

if [ $OAK_OK -eq 0 ] && [ $OAK_HOURLY_OK -eq 0 ]; then
  OAK_FORECAST=$(extract_forecast "$OAK_RAW" "$OAK_HOURLY_RAW" "$WINDOW_TO" "$WINDOW_FROM" "$MATCH_DATE")
else
  OAK_FORECAST="null"
fi

if [ -n "$ALERTS_RAW" ]; then
  SF_ALERTS=$(echo "$ALERTS_RAW" | jq '[.features[].properties | select(.affectedZones | index("https://api.weather.gov/zones/forecast/CAZ006")) | .event] | unique')
  OAK_ALERTS=$(echo "$ALERTS_RAW" | jq '[.features[].properties | select(.affectedZones | index("https://api.weather.gov/zones/forecast/CAZ508")) | .event] | unique')
else
  SF_ALERTS="[]"
  OAK_ALERTS="[]"
fi

# ── Berkeley Marina: forecast high/low + live wind (knots) ───────────
# Wind is the live observation from the nearest reliable station ($MARINA_WIND_STATION,
# default KOAK); if that ob is missing or stale (>2h) we fall back to the gridpoint
# forecast wind, so the row always shows a wind reading.
MARINA_FORECAST_URL="https://api.weather.gov/gridpoints/MTR/89,108/forecast"
MARINA_WIND_STATION="${MARINA_WIND_STATION:-KOAK}"
MARINA_OBS_URL="https://api.weather.gov/stations/${MARINA_WIND_STATION}/observations/latest"

BM_RAW=$(curl -sf -H "User-Agent: $UA" "$MARINA_FORECAST_URL")
BM_OK=$?
BM_OBS_RAW=$(curl -sf -H "User-Agent: $UA" "$MARINA_OBS_URL")
BM_OBS_OK=$?

if [ $BM_OBS_OK -ne 0 ] || [ -z "$BM_OBS_RAW" ]; then
  BM_OBS_JSON="null"
  BM_OBS_AGE=999999
else
  BM_OBS_JSON="$BM_OBS_RAW"
  BM_OBS_TS=$(printf '%s' "$BM_OBS_RAW" | jq -r '.properties.timestamp // empty')
  BM_OBS_EPOCH=$([ -n "$BM_OBS_TS" ] && date -d "$BM_OBS_TS" +%s 2>/dev/null)
  if [ -n "$BM_OBS_EPOCH" ]; then
    BM_OBS_AGE=$(( $(date +%s) - BM_OBS_EPOCH ))
  else
    BM_OBS_AGE=999999
  fi
fi

if [ $BM_OK -eq 0 ]; then
  BERKELEY_MARINA=$(jq -n \
    --slurpfile fc <(printf '%s' "$BM_RAW") \
    --slurpfile obs <(printf '%s' "$BM_OBS_JSON") \
    --argjson obs_age "$BM_OBS_AGE" \
    --arg day "$MATCH_DATE" '
    def kmh_to_kt: . * 0.539957;
    def mph_to_kt: . * 0.868976;
    def deg2compass:
      ["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSW","SW","WSW","W","WNW","NW","NNW"]
      [(((. / 22.5) + 0.5) | floor) % 16];
    def mph_max: ([scan("[0-9]+") | tonumber] | max // 0);
    def on_day: select($day == "" or (.startTime | startswith($day)));
    ($fc[0].properties.periods) as $p |
    ($p | map(select(.isDaytime)       | on_day) | .[0]) as $day_p |
    ($p | map(select(.isDaytime | not) | on_day) | .[0]) as $night_p |
    ($day_p.temperature) as $high |
    ($night_p.temperature) as $low |
    # Wind comes from the period being reported. For today that is the current
    # one, as before; for tomorrow it is the daytime period of that date, since
    # the live observation below describes a night that will be over by then.
    (if $day == "" then $p[0] else ($day_p // $night_p) end) as $wind_p |
    (($wind_p.windSpeed // "") | mph_max | mph_to_kt | round) as $fc_kt |
    ($wind_p.windDirection // null) as $fc_dir |
    ((($obs[0] // {}).properties) // {}) as $o |
    ($o.windSpeed.value) as $spd |
    ($o.windGust.value) as $gust |
    ($o.windDirection.value) as $dir |
    (($day == "") and ($obs_age < 7200) and ($spd != null) and ($dir != null)) as $obs_ok |
    {
      high: $high,
      low: $low,
      wind: (if $obs_ok then {
          dir: ($dir | deg2compass),
          speed_kt: ($spd | kmh_to_kt | round),
          gust_kt: (if $gust != null then ($gust | kmh_to_kt | round) else null end),
          source: "observed"
        } else {
          dir: $fc_dir,
          speed_kt: $fc_kt,
          gust_kt: null,
          source: "forecast"
        } end)
    }')
else
  BERKELEY_MARINA="null"
fi

# ── UV index ─────────────────────────────────────────────────────────
# api.weather.gov has no UV product, so this one comes from Open-Meteo (free,
# keyless). UV varies negligibly across the ~15 miles separating the three rows
# above, so a single Bay Area figure is reported rather than three near-identical
# ones; it is sampled at the Marina, where the sun exposure actually matters.
# uv_index_max is cloud-adjusted, so an overcast day reads lower than the
# clear-sky maximum. Any failure yields null and the row disappears.
UV_LATITUDE="${UV_LATITUDE:-37.865}"
UV_LONGITUDE="${UV_LONGITUDE:--122.315}"
UV_TZ="${WEATHER_TZ:-America/Los_Angeles}"

UV_RAW=$(curl -sf -G -H "User-Agent: $UA" "https://api.open-meteo.com/v1/forecast" \
  --data-urlencode "latitude=$UV_LATITUDE" \
  --data-urlencode "longitude=$UV_LONGITUDE" \
  --data-urlencode "timezone=$UV_TZ" \
  --data "daily=uv_index_max" \
  --data "hourly=uv_index" \
  --data "forecast_days=2")
UV_OK=$?

if [ $UV_OK -eq 0 ] && [ -n "$UV_RAW" ]; then
  UV=$(printf '%s' "$UV_RAW" | jq --arg day "$TARGET_DATE" '
    # WHO exposure bands, applied to the rounded index so the number and the
    # words never disagree (7.6 shows as "8 Very High", not "8 High").
    def band:
      if   . >= 11 then "Extreme"
      elif . >= 8  then "Very High"
      elif . >= 6  then "High"
      elif . >= 3  then "Moderate"
      else "Low" end;
    # Two days are always requested and the reported one is picked by date, so
    # the evening switch needs no second call and today is unaffected.
    ((.daily.time | index($day)) // 0) as $i |
    (.daily.uv_index_max[$i] // null) as $daily_max |
    ([.hourly.time, .hourly.uv_index] | transpose
      | map(select(.[1] != null and (.[0] | startswith($day))))
      | max_by(.[1])) as $peak_hour |
    if $daily_max == null then null else
      ($daily_max | round) as $rounded |
      {
        "max":  $rounded,
        "band": ($rounded | band),
        "peak": (if $peak_hour == null then null
                 else ($peak_hour[0] | split("T")[1][0:5]) end)
      }
    end') || UV="null"
else
  UV="null"
fi

jq -n \
  --argjson sf_forecast "$SF_FORECAST" \
  --argjson oak_forecast "$OAK_FORECAST" \
  --argjson sf_alerts "${SF_ALERTS:-[]}" \
  --argjson oak_alerts "${OAK_ALERTS:-[]}" \
  --argjson berkeley_marina "${BERKELEY_MARINA:-null}" \
  --argjson uv "${UV:-null}" \
  --arg target "$TARGET" \
  --arg target_date "$TARGET_DATE" '
  {
    target: $target,
    target_date: $target_date,
    sf: (if $sf_forecast == null then null else ($sf_forecast + {alerts: $sf_alerts}) end),
    oakland: (if $oak_forecast == null then null else ($oak_forecast + {alerts: $oak_alerts}) end),
    berkeley_marina: $berkeley_marina,
    uv: $uv
  }
'
