# plugin/src/settings.yml.example — template for the plugin definition.
#
# The real settings.yml is what `trmnlp push` uploads, and its polling_headers
# carry the shared secret the polling URL is gated on. It is gitignored and
# built from this file by ./setup, which fills the token in from .env.
#
# Editing this file does not change your local settings.yml — ./setup only
# seeds one that does not exist yet, the same as it does for .env.
---
strategy: polling
no_screen_padding: 'no'
dark_mode: 'no'
static_data: ''
polling_verb: get
framework_version: 2.3.7
serverless_language: ''
polling_url: https://retend.app/trmnl.json
polling_headers: content-type=application/json&x-plugin-token=REPLACE_WITH_TRMNL_PLUGIN_TOKEN
polling_body: ''
id: 243914
oauth_enabled: 'false'
oauth_pkce_enabled: 'no'
oauth_authorize_url: ''
oauth_token_url: ''
oauth_scopes: ''
oauth_scope_separator: ''
oauth_refresh_url: ''
oauth_auth_params: ''
oauth_token_headers: ''
oauth_token_site: ''
oauth_token_params: ''
oauth_token_request_auth_method: ''
oauth_body_format: ''
oauth_token_response_metadata: ''
oauth_authorization_method: ''
oauth_refresh_params: ''
oauth_token_field_name: ''
oauth_expiry_field_name: ''
oauth_expiry_strategy: ''
oauth_fixed_expiry_ms: ''
name: TRMNL Smartscreen
description:
refresh_interval: 15
