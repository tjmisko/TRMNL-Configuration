#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CDPATH=
cd "$SCRIPT_DIR"

# ── 1. Check prerequisites ──────────────────────────────────────────
if ! command -v go &>/dev/null && [[ -x /usr/local/go/bin/go ]]; then
  export PATH="/usr/local/go/bin:$PATH"
  echo "Found go at /usr/local/go/bin/go, added to PATH"
fi

missing=()
for cmd in jq rg curl go unzip; do
  command -v "$cmd" &>/dev/null || missing+=("$cmd")
done

if [[ ${#missing[@]} -gt 0 ]]; then
  echo "Missing required tools: ${missing[*]}"
  echo "Install them and re-run ./setup"
  exit 1
fi

# ── 2. Create .env from template ─────────────────────────────────────
if [[ ! -f .env ]]; then
  echo "Creating .env from .env.example..."
  cp .env.example .env
  sed -i "s|^PROJECT_DIRECTORY=.*|PROJECT_DIRECTORY=\"$SCRIPT_DIR\"|" .env

  default_notes="$HOME/Documents/Notes"
  read -rp "Path to notes vault [$default_notes]: " notes_dir
  notes_dir="${notes_dir:-$default_notes}"
  sed -i "s|^NOTES_DIRECTORY=.*|NOTES_DIRECTORY=\"$notes_dir\"|" .env
  sed -i 's/\r$//' .env

  echo ".env created"
else
  echo ".env already exists, skipping"
fi

# ── 3. Fetch BART static GTFS data ──────────────────────────────────
echo "Checking BART static GTFS data..."
BART/refresh-gtfs --if-stale

# ── 3a. Build BART binary ───────────────────────────────────────────
if [[ ! -f BART/bart || BART/bart.go -nt BART/bart ]]; then
  echo "Building BART binary..."
  (cd -- BART && go build -o bart .)
  echo "BART built"
else
  echo "BART binary is up to date"
fi

# ── 3b. Build ICS events binary ─────────────────────────────────────
if [[ ! -f events/sources/ics || events/ics/ics.go -nt events/sources/ics ]]; then
  echo "Building ICS events binary..."
  (cd -- events/ics && go build -o ../sources/ics .)
  echo "ICS built"
else
  echo "ICS binary is up to date"
fi

# ── 3b2. Build tides events filter ──────────────────────────────────
mkdir -p events/filters
if [[ ! -f events/filters/tides || events/tides/tides.go -nt events/filters/tides ]]; then
  echo "Building tides events filter..."
  (cd -- events/tides && go build -o ../filters/tides .)
  echo "Tides filter built"
else
  echo "Tides filter is up to date"
fi

# ── 3b3. Retire the old CSC events source ───────────────────────────
# The Cal Sailing event used to be a source adapter reading csc-lessons.conf;
# it is now a vault note (events/vault-notes/sailing) plus the tides filter. An
# old binary left behind in sources/ would keep emitting a second, un-clamped
# copy of the event, so clear it out — and carry its cached club hours over so
# the first run after upgrading doesn't have to hit the network.
if [[ -f events/sources/csc ]]; then
  rm -f events/sources/csc
  echo "Removed the retired events/sources/csc adapter"
fi
if [[ -f events/sources/.csc-cache.json && ! -f events/filters/.csc-cache.json ]]; then
  mv events/sources/.csc-cache.json events/filters/.csc-cache.json
  echo "Moved the cached Cal Sailing hours to events/filters/"
fi
rm -f events/sources/.csc-cache.json
if [[ -f events/csc-lessons.conf ]]; then
  echo "Note: events/csc-lessons.conf is no longer read — the lesson schedule now"
  echo "      lives in your vault (copy events/vault-notes/sailing/*.md into it)."
fi

# ── 3c. Seed events config files from their examples ────────────────
if [[ ! -f events/feeds.conf ]]; then
  cp events/feeds.conf.example events/feeds.conf
  echo "events/feeds.conf created — add your Luma/Google calendar feeds to it"
else
  echo "events/feeds.conf already exists, skipping"
fi

if [[ ! -f events/ignore.conf ]]; then
  cp events/ignore.conf.example events/ignore.conf
  echo "events/ignore.conf created — add title globs for events to hide"
else
  echo "events/ignore.conf already exists, skipping"
fi

if [[ ! -f events/tags.conf ]]; then
  cp events/tags.conf.example events/tags.conf
  echo "events/tags.conf created — edit it to change the event tags and their order"
else
  echo "events/tags.conf already exists, skipping"
fi

if [[ ! -f events/sources.conf ]]; then
  cp events/sources.conf.example events/sources.conf
  echo "events/sources.conf created — switch individual event sources on and off there"
else
  echo "events/sources.conf already exists, skipping"
fi

# ── 4. Ensure scripts are executable ────────────────────────────────
chmod +x update birthday/fetch tasks/fetch weather/fetch checklists/fetch \
  events/fetch events/sources/recurring BART/refresh-gtfs BART/fetch
echo "Scripts marked executable"

# ── 5. Smoke test ───────────────────────────────────────────────────
echo "Running smoke test..."
if ./update && [[ -f trmnl.json ]]; then
  echo "Smoke test passed — trmnl.json written"
else
  echo "Smoke test failed — check output above"
  exit 1
fi

echo "Setup complete"
