#!/usr/bin/env bash
# Events source adapter: recurring weekly and monthly events from the Notes vault.
#
# Scans Markdown notes anywhere under $NOTES_DIRECTORY whose YAML frontmatter is
# tagged with BOTH `event` and `recurring`, and emits the ones whose `weekday`
# (and optional `week`) match *today* as a JSON array of normalized event
# objects (schema in events/README.md).
#
# Expected frontmatter (first --- block at the top of the file):
#   ---
#   start: 20:00          # 24-hour local time (omit for an all-day event)
#   end:   23:30          # optional
#   start_dst: 21:00      # optional; replaces start while DST is in effect
#   end_dst:   00:30      # optional; replaces end while DST is in effect
#   weekday: Monday       # full or 3-letter; also accepts a CSV list (Mon, Thu)
#   week: 1, 3            # optional; nth Monday of the month. Omit = every week.
#   message: Bring ID     # optional; rendered as an indented sub-line
#   tags:
#     - event
#     - recurring
#     - dance             # every tag beyond event/recurring rides along on the
#   ---                   # emitted event, for events/tags.conf to match on
# Title defaults to the note's filename (override with a `title:` field).
#
# `week` counts occurrences of the note's `weekday` within the month, matching
# the ordinal BYDAY semantics of RRULE (`2SA` = second Saturday), so the same
# event reads the same whether it arrives from a note or from an .ics feed.
# Accepted tokens: 1..5, 1st..5th, first..fifth, and last (= -1, the final such
# weekday of the month, which is the 4th or 5th depending on the month).
#
# Overlapping/conflicting events are intentionally kept. Emits [] if the notes
# directory is unset or missing.
# >/dev/null guards against a set CDPATH making `cd` echo the path (which would
# otherwise be captured into SCRIPT_DIR and double it).
SCRIPT_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"

# events/fetch exports the config it already resolved; .env is only the fallback
# for running this adapter on its own. Sourcing .env would clobber those exports
# with plain assignments, so hold the caller's values across the source and let
# them win — that also lets the tests aim the adapter at a scratch vault.
CALLER_NOTES_DIRECTORY="${NOTES_DIRECTORY:-}"
CALLER_EVENTS_TZ="${EVENTS_TZ:-}"
source "$SCRIPT_DIR/../../.env" 2>/dev/null

EVENTS_TZ="${CALLER_EVENTS_TZ:-${EVENTS_TZ:-America/Los_Angeles}}"
TODAY="${EVENTS_TODAY:-$(TZ="$EVENTS_TZ" date +%Y-%m-%d)}"
ROOT="${CALLER_NOTES_DIRECTORY:-${NOTES_DIRECTORY:-}}"

if [[ -z "$ROOT" || ! -d "$ROOT" ]]; then
  echo '[]'
  exit 0
fi

# Everything below is derived from $TODAY (not from the wall clock) so that a
# caller-supplied $EVENTS_TODAY reschedules the whole adapter coherently.
TODAY_FULL=$(TZ="$EVENTS_TZ" date -d "$TODAY" +%A 2>/dev/null | tr '[:upper:]' '[:lower:]')
TODAY_ABBR=${TODAY_FULL:0:3}

# An unparseable $EVENTS_TODAY would leave the weekday empty, and an empty
# weekday matches every note. Bail out rather than emit the whole vault.
if [[ -z "$TODAY_FULL" ]]; then
  printf 'events/sources/recurring: unparseable date %s\n' "$TODAY" >&2
  echo '[]'
  exit 0
fi

# Which occurrence of this weekday within the month today is: day 1-7 → 1st,
# 8-14 → 2nd, and so on. `last` is true when no further same-weekday remains.
TODAY_DAY_OF_MONTH=$(TZ="$EVENTS_TZ" date -d "$TODAY" +%-d)
TODAY_DAYS_IN_MONTH=$(TZ="$EVENTS_TZ" \
  date -d "$(TZ="$EVENTS_TZ" date -d "$TODAY" +%Y-%m-01) +1 month -1 day" +%-d)
TODAY_WEEK_ORDINAL=$(( (TODAY_DAY_OF_MONTH - 1) / 7 + 1 ))
TODAY_IS_LAST_WEEKDAY_OF_MONTH=$(( TODAY_DAY_OF_MONTH + 7 > TODAY_DAYS_IN_MONTH ))

# Whether Daylight Saving Time is in effect on $TODAY, worked out from the zone
# itself rather than a hardcoded rule: DST is on when today's UTC offset is
# bigger than the year's standard offset — the smaller of a midwinter and a
# midsummer sample, which lands correctly in both hemispheres. A zone with no
# DST has one offset all year and so always answers "no".
offset_minutes() { # "-0800" -> -480
  local raw="$1" sign=1
  [[ ${raw:0:1} == "-" ]] && sign=-1
  printf '%s' $(( sign * (10#${raw:1:2} * 60 + 10#${raw:3:2}) ))
}

TODAY_YEAR=$(TZ="$EVENTS_TZ" date -d "$TODAY" +%Y)
TODAY_IS_DST=0
if now_offset=$(TZ="$EVENTS_TZ" date -d "$TODAY 12:00" +%z 2>/dev/null) &&
  jan_offset=$(TZ="$EVENTS_TZ" date -d "$TODAY_YEAR-01-15 12:00" +%z 2>/dev/null) &&
  jul_offset=$(TZ="$EVENTS_TZ" date -d "$TODAY_YEAR-07-15 12:00" +%z 2>/dev/null); then
  standard=$(offset_minutes "$jan_offset")
  midsummer=$(offset_minutes "$jul_offset")
  (( midsummer < standard )) && standard=$midsummer
  (( $(offset_minutes "$now_offset") > standard )) && TODAY_IS_DST=1
fi

# True when a note's `week` spec covers today. An empty spec means "every week"
# (the original behavior). A spec whose tokens are all unrecognized matches
# nothing — a typo hides the event rather than showing it on every wrong week.
week_matches() {
  local spec token ordinal recognized_any=0
  local -a tokens
  spec=$(printf '%s' "$1" | tr ',;' '  ' | tr '[:upper:]' '[:lower:]')
  [[ -z "${spec// /}" ]] && return 0
  read -ra tokens <<<"$spec"   # read, not word-splitting: a stray `*` must not glob

  for token in "${tokens[@]}"; do
    case "$token" in
      1|1st|first)  ordinal=1 ;;
      2|2nd|second) ordinal=2 ;;
      3|3rd|third)  ordinal=3 ;;
      4|4th|fourth) ordinal=4 ;;
      5|5th|fifth)  ordinal=5 ;;
      -1|last)
        recognized_any=1
        (( TODAY_IS_LAST_WEEKDAY_OF_MONTH )) && return 0
        continue
        ;;
      *) continue ;;
    esac
    recognized_any=1
    (( ordinal == TODAY_WEEK_ORDINAL )) && return 0
  done

  (( recognized_any )) && return 1
  printf 'events/sources/recurring: %s: unrecognized week: %s\n' "$2" "$1" >&2
  return 1
}

# Extract the YAML frontmatter block (first --- ... --- at the top), CR-stripped.
frontmatter() {
  awk '{sub(/\r$/,"")} NR==1 && $0=="---"{f=1;next} f && $0=="---"{exit} f{print}' "$1"
}

# Single-line frontmatter value by key (case-insensitive), quotes trimmed.
fm_get() {
  printf '%s\n' "$1" \
    | sed -n "s/^[[:space:]]*$2[[:space:]]*:[[:space:]]*//Ip" \
    | head -1 \
    | sed 's/\r$//; s/^["'\'']//; s/["'\'']$//'
}

# Frontmatter tags as lowercase tokens, one per line. Handles the YAML block
# list, an inline [a, b] array, and a bare CSV; tolerates a leading `#`.
fm_tags() {
  printf '%s\n' "$1" | awk '
    /^tags[[:space:]]*:/ {
      intag=1; rest=$0; sub(/^tags[[:space:]]*:[[:space:]]*/,"",rest)
      if (rest != "") print rest
      next
    }
    intag {
      if ($0 ~ /^[[:space:]]*-[[:space:]]*/) { sub(/^[[:space:]]*-[[:space:]]*/,""); print; next }
      if ($0 ~ /^[^[:space:]]/) { intag=0 }
    }
  ' \
    | tr ',[]' '   ' \
    | tr '[:upper:]' '[:lower:]' \
    | tr -s '[:space:]' '\n' \
    | sed 's/^#//; s/^["'\'']//; s/["'\'']$//' \
    | grep -v '^$'
}

emit_one() {
  local file="$1" fm tags days weeks start end start_dst end_dst title message
  fm=$(frontmatter "$file")
  [[ -z "$fm" ]] && return

  # Identify a recurring event: must carry BOTH the `event` and `recurring` tags.
  tags=$(fm_tags "$fm")
  grep -qx 'event' <<<"$tags" || return
  grep -qx 'recurring' <<<"$tags" || return

  # Show only if its weekday is today (full or 3-letter, case-insensitive, CSV ok).
  days=$(printf '%s %s' "$(fm_get "$fm" weekday)" "$(fm_get "$fm" weekdays)" \
    | tr '[:upper:]' '[:lower:]')
  echo "$days" | grep -qE "(^|[^a-z])($TODAY_FULL|$TODAY_ABBR)([^a-z]|$)" || return

  # ...and, for monthly series, only on the listed occurrence(s) of that weekday.
  weeks=$(printf '%s %s' "$(fm_get "$fm" week)" "$(fm_get "$fm" weeks)")
  week_matches "$weeks" "$(basename "$file")" || return

  start=$(fm_get "$fm" start)
  end=$(fm_get "$fm" end)

  # A note may carry a Daylight-Saving variant of its window (Cal Sailing runs
  # its afternoon lesson an hour later in summer). Each side overrides
  # independently, so a note can shift only its end.
  if (( TODAY_IS_DST )); then
    start_dst=$(fm_get "$fm" start_dst)
    end_dst=$(fm_get "$fm" end_dst)
    [[ -n "$start_dst" ]] && start=$start_dst
    [[ -n "$end_dst" ]] && end=$end_dst
  fi

  message=$(fm_get "$fm" message)
  title=$(fm_get "$fm" title)
  [[ -z "$title" ]] && title=$(basename "$file" .md)

  # Every tag past the two structural ones (`event`, `recurring`) rides along on
  # the event so events/tags.conf can classify it by `tag:<name>` — the
  # frontmatter provenance of the dashboard's tagging.
  jq -n \
    --arg title "$title" \
    --arg start "$start" \
    --arg end_time "$end" \
    --arg message "$message" \
    --arg tags_raw "$tags" \
    --arg date "$TODAY" '
    {
      title:   $title,
      start:   (if $start == "" then null else $start end),
      "end":   (if $end_time == "" then null else $end_time end),
      all_day: ($start == ""),
      message: (if $message == "" then null else $message end),
      tags:    ($tags_raw | split("\n")
                | map(select(. != "" and . != "event" and . != "recurring"))
                | unique),
      date:    $date,
      sort:    ($date + "T" + (if $start == "" then "00:00" else $start end)),
      source:  "recurring"
    }'
}

# Prefilter to notes that even mention the `recurring` tag, so we only parse
# frontmatter where it could match; the per-file check enforces both tags.
{
  while IFS= read -r file; do
    [[ -n "$file" ]] && emit_one "$file"
  done < <(rg -l --no-messages -i --glob '*.md' -- 'recurring' "$ROOT")
} | jq -s 'sort_by(.sort, .title)'
