# Path to Obsidian/notes vault containing people/ and task files
NOTES_DIRECTORY="/path/to/your/notes"
# Auto-resolved by setup — no need to edit
PROJECT_DIRECTORY="/path/to/GooseTRM"

# ── Events ──────────────────────────────────────────────────────────
# Luma calendar .ics subscription URL (Subscribe → "Add to Calendar").
# Leave blank until you have it — the events pipeline degrades to empty.
# with start/end/day). Defaults to "events" if unset.
# IANA timezone used to resolve "today" and localize event times.

# ── TRMNL plugin ────────────────────────────────────────────────────
# Shared secret the hosted polling URL is gated on: nginx 404s /trmnl.json
# without a matching X-Plugin-Token. The value the device actually sends lives
# in the plugin's `plugin_token` custom field on trmnl.com — set it there once,
# and it stays out of this repo entirely. This variable is only the local
# mirror: plugin/.trmnlp.yml reads it so `./trmnlp serve` matches production,
# and it is what you would curl the endpoint with. Safe to leave unset.
TRMNL_PLUGIN_TOKEN=""
